# Copy to .env.local and fill in from your Supabase project settings.
# Never commit .env.local: it is gitignored for a reason.

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (anon) key. Safe to expose to the browser: it is read only
# and constrained by row level security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret (service role) key. Server side only, used by the ingestion scripts
# in scripts/ to write the register into Postgres. Never expose this.
SUPABASE_SECRET_KEY=
